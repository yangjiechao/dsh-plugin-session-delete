{
  "name": "dsh-plugin-session-delete",
  "version": "0.1.0",
  "description": "Permanently delete archived, unloaded DSH session logs with a warning dialog and explicit confirmation. Not a privacy eraser.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/yangjiechao/dsh-plugin-session-delete.git" },
  "bugs": { "url": "https://github.com/yangjiechao/dsh-plugin-session-delete/issues" },
  "homepage": "https://github.com/yangjiechao/dsh-plugin-session-delete#readme",
  "engines": { "node": ">=22.12.0", "dsh": ">=0.2.2-rc.3 <0.2.3-0" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "deletion.js", "client.js", "cordis.patch.yml", "locale", "icon.svg", "README.md", "README.en.md", "SECURITY.md", "VERIFICATION.md", "LICENSE", "test"],
  "scripts": { "test": "node --test test/*.test.mjs", "check": "node --check index.js && node --check deletion.js && node --check client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-locale"] }
  }
}
